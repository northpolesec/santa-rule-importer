<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.northpolesec.santa</string>
			<key>FileAccessPolicy</key>
			<dict>
				<key>Version</key>
				<string>2.0</string>
				<key>EventDetailURL</key>
				<string>https://example.com/mobileconfig-faa</string>
				<key>WatchItems</key>
				<dict>
					<key>ConfigData</key>
					<dict>
						<key>Paths</key>
						<array>
							<dict>
								<key>Path</key>
								<string>/etc/ssh/</string>
								<key>IsPrefix</key>
								<true/>
							</dict>
						</array>
						<key>Processes</key>
						<array>
							<dict>
								<key>SigningID</key>
								<string>com.openssh.sshd</string>
							</dict>
						</array>
						<key>Options</key>
						<dict>
							<key>RuleType</key>
							<string>PathsWithAllowedProcesses</string>
							<key>AuditOnly</key>
							<false/>
						</dict>
					</dict>
				</dict>
			</dict>
		</dict>
	</array>
	<key>PayloadType</key>
	<string>Configuration</string>
</dict>
</plist>
